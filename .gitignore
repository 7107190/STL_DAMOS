# DAMOS GitHub mirror ignores generated output and vendor checkouts.

# Runtime/generated output
Carla-0.9.16-source/_DAMOS/logs/
Carla-0.9.16-source/_DAMOS/reports/
Carla-0.9.16-source/_DAMOS/_tmp_sync/
Carla-0.9.16-source/_DAMOS/_tmp_upload/
Carla-0.9.16-source/_DAMOS/backups/
Carla-0.9.16-source/_DAMOS/legacy_stl_damos/

# Large source assets kept only on vvu
Carla-0.9.16-source/_DAMOS/3d_model/

# Full CARLA vendor/build tree. Only selected overlay paths are tracked.
Carla-0.9.16-source/*
!Carla-0.9.16-source/Scenic/
!Carla-0.9.16-source/Unreal/
!Carla-0.9.16-source/_DAMOS/

Carla-0.9.16-source/Scenic/*
!Carla-0.9.16-source/Scenic/README.md
!Carla-0.9.16-source/Scenic/Maps/
Carla-0.9.16-source/Scenic/Maps/*.snet

Carla-0.9.16-source/Unreal/*
!Carla-0.9.16-source/Unreal/CarlaUE4/
Carla-0.9.16-source/Unreal/CarlaUE4/*
!Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/
Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/*
!Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/Carla/
Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/Carla/*
!Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/Carla/Source/
Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/Carla/Source/*
!Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/Carla/Source/Carla/
Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/Carla/Source/Carla/*
!Carla-0.9.16-source/Unreal/CarlaUE4/Plugins/Carla/Source/Carla/Damos/

# Full Unreal Engine checkout is external. Keep only dependency note.
UnrealEngine_4.26/*
!UnrealEngine_4.26/README.md

# Python/cache/editor/OS files
__pycache__/
*.py[cod]
*.pyo
*.log
*.tmp
.venv/
venv/
.vscode/
.idea/
.DS_Store
._.DS_Store
Thumbs.db
